# Mode « maquette » : données FICTIVES, aucune base réelle, aucune clé réelle.
# - `npm run dev:mock` : le serveur de dev répond lui-même aux appels Supabase (scripts/mock-api.ts).
# - `npm run build:mock` : build des tests de bout en bout, dont Playwright intercepte les appels.
# Scénario du serveur de dev : variable HUTE_MOCK = complet (défaut), attente, clos, sans-guests.
VITE_SUPABASE_URL=/__mock__
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fictive
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
