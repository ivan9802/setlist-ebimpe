{
  "name": "himra-ultra-tracklist",
  "version": "0.1.0",
  "private": true,
  "description": "HIMRA ULTRA TRACKLIST EXPERIENCE : set-lists de fans pour le concert du Stade d'Ebimpé (initiative indépendante).",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "preview": "wrangler dev --port 8787",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "check:budgets": "node scripts/check-budgets.ts",
    "check:secrets": "node scripts/check-secrets.ts",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run check:budgets && npm run check:secrets"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@sentry/browser": "11.12.0",
    "@supabase/supabase-js": "2.119.0",
    "html-to-image": "1.11.13",
    "motion": "14.12.0",
    "papaparse": "5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.0",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "wrangler": "4.160.1"
  },
  "overrides": {
    "playwright-core": "1.65.0"
  }
}
