# Copier en .env.local pour le développement. Ne jamais committer de vraie valeur.
# Les variables VITE_* sont publiques PAR CONCEPTION (elles finissent dans le bundle).

# Supabase : URL du projet et clé publiable (sécurité assurée par RLS, ADR-002)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Turnstile : clé de site. En local, la clé de test Cloudflare « toujours valide ».
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Sentry : DSN public (facultatif en local)
VITE_SENTRY_DSN=

# --- Worker local : à placer dans .dev.vars (lu par `wrangler dev`), JAMAIS dans le bundle ---
# SUPABASE_SECRET_KEY=
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
